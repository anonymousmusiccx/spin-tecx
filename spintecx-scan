#!/data/data/com.termux/files/usr/bin/bash
#
# spintecx-scan — website reputation scanner using the VirusTotal API v3
# Usage: spintecx-scan <url>

set -o pipefail

CONFIG_DIR="$HOME/.spintecx"
CONFIG_FILE="$CONFIG_DIR/config"
VT_API_BASE="https://www.virustotal.com/api/v3"

# ---- colors ----
GREEN='\033[0;32m'
BRIGHT_GREEN='\033[1;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
BOLD='\033[1m'
RESET='\033[0m'

gradient_text() {
  local text="$1"
  # green -> cyan -> blue 256-color gradient, hacker vibe
  local colors=(46 47 48 49 50 51 87 123 159 195)
  local i=0
  local len=${#text}
  for (( j=0; j<len; j++ )); do
    local ch="${text:$j:1}"
    if [ "$ch" = " " ]; then
      printf " "
    else
      local color="${colors[$((i % ${#colors[@]}))]}"
      printf "\033[1;38;5;%sm%s" "$color" "$ch"
      i=$((i + 1))
    fi
  done
  printf "${RESET}\n"
}

banner() {
  echo ""
  gradient_text "S P I N   T E C X"
  echo -e "${GRAY}  url reputation scanner${RESET}"
  echo -e "${GRAY}  powered by VirusTotal${RESET}"
  echo ""
}

die() {
  echo -e "${RED}[!] $1${RESET}" >&2
  exit 1
}

check_deps() {
  command -v curl >/dev/null 2>&1 || die "curl not found. Install with: pkg install curl"
  command -v jq >/dev/null 2>&1 || die "jq not found. Install with: pkg install jq"
}

load_or_prompt_key() {
  mkdir -p "$CONFIG_DIR"
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi

  if [ -z "$VT_API_KEY" ]; then
    echo -e "${YELLOW}[*] No VirusTotal API key found.${RESET}"
    echo -e "${GRAY}    Get a free key at https://www.virustotal.com/gui/join-us${RESET}"
    read -rp "$(echo -e "${CYAN}[?] Paste your VirusTotal API key: ${RESET}")" input_key
    [ -z "$input_key" ] && die "No key provided. Aborting."
    echo "VT_API_KEY=\"$input_key\"" > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    VT_API_KEY="$input_key"
    echo -e "${GREEN}[+] Key saved to $CONFIG_FILE${RESET}\n"
  fi
}

url_encode_id() {
  # VirusTotal v3 wants the URL id as base64url of the URL, no padding
  printf '%s' "$1" | base64 | tr '+/' '-_' | tr -d '='
}

spinner_wait() {
  local msg="$1"
  local delay=0.15
  local chars="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
  echo -ne "${GRAY}[*] ${msg} "
  for i in $(seq 1 20); do
    local c=${chars:$((i % ${#chars})):1}
    echo -ne "\b$c"
    sleep "$delay"
  done
  echo -e "\b${RESET}"
}

main() {
  local target="$1"
  [ -z "$target" ] && { echo "Usage: spintecx-scan <url>"; exit 1; }

  # prepend scheme if missing
  case "$target" in
    http://*|https://*) : ;;
    *) target="http://$target" ;;
  esac

  banner
  check_deps
  load_or_prompt_key

  echo -e "${BOLD}Target:${RESET} $target\n"

  local url_id
  url_id=$(url_encode_id "$target")

  # submit URL for analysis (also works if VT already has it cached)
  echo -e "${GRAY}[*] Submitting URL to VirusTotal...${RESET}"
  local submit_resp
  submit_resp=$(curl -s -X POST "$VT_API_BASE/urls" \
    -H "x-apikey: $VT_API_KEY" \
    --data-urlencode "url=$target")

  local analysis_id
  analysis_id=$(echo "$submit_resp" | jq -r '.data.id // empty')

  if [ -z "$analysis_id" ]; then
    local err_msg
    err_msg=$(echo "$submit_resp" | jq -r '.error.message // "unknown error"')
    die "Submission failed: $err_msg"
  fi

  # poll analysis until complete
  local status="queued"
  local tries=0
  while [ "$status" != "completed" ] && [ "$tries" -lt 15 ]; do
    sleep 2
    local analysis_resp
    analysis_resp=$(curl -s "$VT_API_BASE/analyses/$analysis_id" -H "x-apikey: $VT_API_KEY")
    status=$(echo "$analysis_resp" | jq -r '.data.attributes.status // "unknown"')
    tries=$((tries + 1))
    echo -ne "${GRAY}[*] Scan status: $status ($tries/15)\r${RESET}"
  done
  echo ""

  if [ "$status" != "completed" ]; then
    die "Scan timed out. Try again in a minute (VirusTotal queue may be busy)."
  fi

  local stats
  stats=$(echo "$analysis_resp" | jq -r '.data.attributes.stats')
  local malicious suspicious harmless undetected timeout
  malicious=$(echo "$stats" | jq -r '.malicious')
  suspicious=$(echo "$stats" | jq -r '.suspicious')
  harmless=$(echo "$stats" | jq -r '.harmless')
  undetected=$(echo "$stats" | jq -r '.undetected')
  timeout=$(echo "$stats" | jq -r '.timeout')

  local total=$((malicious + suspicious + harmless + undetected + timeout))

  echo -e "${GRAY}────────────────────────────────────────${RESET}"
  echo -e "${BOLD}SCAN RESULT${RESET}"
  echo -e "${GRAY}────────────────────────────────────────${RESET}"

  if [ "$malicious" -gt 0 ]; then
    echo -e "${RED}${BOLD}[!] MALICIOUS — flagged by $malicious/$total vendors${RESET}"
  elif [ "$suspicious" -gt 0 ]; then
    echo -e "${YELLOW}${BOLD}[!] SUSPICIOUS — flagged by $suspicious/$total vendors${RESET}"
  else
    echo -e "${GREEN}${BOLD}[+] CLEAN — no vendors flagged this URL${RESET}"
  fi

  echo ""
  echo -e "${GRAY}Malicious   :${RESET} $malicious"
  echo -e "${GRAY}Suspicious  :${RESET} $suspicious"
  echo -e "${GRAY}Harmless    :${RESET} $harmless"
  echo -e "${GRAY}Undetected  :${RESET} $undetected"
  echo -e "${GRAY}Total engines:${RESET} $total"
  echo -e "${GRAY}────────────────────────────────────────${RESET}"

  local report_url="https://www.virustotal.com/gui/url/$url_id"
  echo -e "${CYAN}Full report:${RESET} $report_url"

  # exit code: 0 clean, 1 malicious, 2 suspicious
  if [ "$malicious" -gt 0 ]; then
    exit 1
  elif [ "$suspicious" -gt 0 ]; then
    exit 2
  else
    exit 0
  fi
}

main "$@"
